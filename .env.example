# Copy to .env for local development only. Never commit real credentials.
NODE_ENV=development
PORT=3000

# Create a NEW, EMPTY MySQL database for the clean-start environment.
# Replace this placeholder with its private connection string.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# Generate a unique secret locally (at least 32 characters; 64+ recommended).
# Example command: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
APP_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
